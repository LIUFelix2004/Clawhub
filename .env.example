# ClawAlert 多链代币监控系统配置
# 复制此文件为 .env 并填写您的配置

# OKX API 配置（用于获取代币数据）
OKX_API_KEY="your_okx_api_key_here"
OKX_SECRET_KEY="your_okx_secret_key_here"
OKX_PASSPHRASE="your_okx_passphrase_here"

# Discord 通知配置
DISCORD_CHANNEL="channel:your_discord_channel_id_here"
OPENCLAW_PATH="/path/to/openclaw"  # 如果使用OpenClaw进行通知

# Notion 配置（可选，用于数据同步）
NOTION_API_KEY="ntn_your_notion_api_key_here"
NOTION_DATABASE_ID="your_notion_database_id_here"

# 监控配置
MIN_MARKET_CAP=1000000  # 最小市值 $1M
VOLUME_SURGE_THRESHOLD=0.3  # 30%交易量增长阈值
LARGE_TRADE_THRESHOLD=10000  # 大额交易阈值 $10,000
CHECK_INTERVAL_MINUTES=10  # 检查间隔（分钟）

# 链配置（true/false启用或禁用）
ENABLE_BSC=true
ENABLE_ETHEREUM=true
ENABLE_SOLANA=true
ENABLE_BASE=true